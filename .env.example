# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=peblo
POSTGRES_USER=peblo
POSTGRES_PASSWORD=change_me_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://peblo:change_me_dev@db:5432/peblo

# JWT
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/storage
LOCAL_STORAGE_URL=http://localhost:8000/storage

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Frontend integration
CMS_API_URL=http://localhost:8000
VIEWER_API_URL=http://localhost:8000

# Development users (safe defaults only)
DEV_EDITOR_EMAIL=editor@peblo.local
DEV_EDITOR_PASSWORD=change_me_dev
DEV_ADMIN_EMAIL=admin@peblo.local
DEV_ADMIN_PASSWORD=change_me_dev
